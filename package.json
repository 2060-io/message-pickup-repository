{
  "name": "message-pickup-repository",
  "private": true,
  "license": "Apache-2.0",
  "description": "Message Pickup Repository implementations for Credo agents",
  "packageManager": "pnpm@9.15.3",
  "repository": {
    "url": "https://github.com/2060-io/message-pickup-repository",
    "type": "git"
  },
  "scripts": {
    "check-types": "eslint \"{src,apps,libs,test,packages}/**/*.ts\"",
    "prettier": "prettier '**/*.+(js|json|ts|tsx|md|yml|yaml)'",
    "format": "pnpm prettier --write",
    "check-format": "pnpm prettier --list-different",
    "test": "pnpm -r test -- --passWithNoTests",
    "test:e2e": "jest --config ./apps/server/test/jest-e2e.json",
    "lint": "eslint --ignore-path .gitignore --ignore-pattern '**/esm/' .",
    "validate": "pnpm lint && pnpm check-types && pnpm check-format"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
